# Database Configuration
DATABASE_URL=sqlite:///./radio_passes.db

# Airtable Integration (Optional)
AIRTABLE_API_KEY=your_api_key_here
AIRTABLE_BASE_ID=your_base_id_here
# Name of the Airtable table containing all staff with "Email address" and "Department" columns
AIRTABLE_TABLE_NAME=KALX Active Staff Directory

# DJ Studio Network Access
# CIDR notation for DJ studio IP range that bypasses authentication for all DJ pages
# Examples: 192.168.1.100/32 (single IP) or 192.168.1.0/24 (subnet)
DJ_STUDIO_NETWORK=192.168.1.0/24

# Station Office Network Access
# CIDR notation for the broader station office network that grants access to the
# winner search page only. Must be a superset of DJ_STUDIO_NETWORK.
# Examples: 192.168.0.0/16 (larger subnet containing the DJ studio network)
STATION_OFFICE_NETWORK=192.168.0.0/16

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# For production, set to your actual domain(s)
# Example: CORS_ORIGINS=https://promotions.example.com,https://www.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Environment
# Controls staging-only features (e.g., test data seeding, user impersonation).
# Set to "staging" on the staging server; leave as "production" (default) everywhere else.
# ENVIRONMENT=staging

# Email Notifications via smtp2go (primary) or the OS's local SMTP relay (fallback)
# When SMTP2GO_API_KEY is set, emails are sent through smtp2go. When it is not set,
# emails are sent via the local SMTP relay configured with LOCAL_SMTP_HOST/LOCAL_SMTP_PORT
# (defaults to localhost:25, i.e. whatever outbound mail capability the OS provides).
# In either case, when ENVIRONMENT=staging, emails are logged instead of sent.
# Exception: in staging, emails to WEBMASTER_EMAIL are always sent (see below).
SMTP2GO_API_KEY=your_api_key_here
EMAIL_FROM_ADDRESS=noreply@kalx.berkeley.edu
# LOCAL_SMTP_HOST=localhost
# LOCAL_SMTP_PORT=25

# Webmaster email address
# Receives user feedback and bug reports submitted via the in-app feedback form.
# In staging, this is the only address that actually receives email (all other
# notifications remain logged-only).
WEBMASTER_EMAIL=webmaster@kalx.berkeley.edu
