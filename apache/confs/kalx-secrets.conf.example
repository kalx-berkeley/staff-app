# Apache secrets for KALX staff portal (production and staging).
#
# This file is NOT a VirtualHost config — it defines secret variables consumed
# by the site configs via ${VARIABLE} substitution.
#
# Non-secret variables (CLIENT_ID, DJ_STUDIO_NETWORK) live in a separate file:
#   apache/confs/kalx-variables.conf.example → /etc/apache2/conf-available/kalx-variables.conf
#
# THIS FILE MUST NOT BE WORLD-READABLE.  After copying, set strict permissions:
#
# Deployment:
#   sudo cp apache/confs/kalx-secrets.conf.example \
#              /etc/apache2/conf-available/kalx-secrets.conf
#   sudo chown root:root /etc/apache2/conf-available/kalx-secrets.conf
#   sudo chmod 640 /etc/apache2/conf-available/kalx-secrets.conf
#   # Fill in all values below, then:
#   sudo a2enconf kalx-secrets
#   sudo apache2ctl configtest && sudo systemctl reload apache2
#
# Verify permissions before reloading:
#   stat -c '%a %U:%G %n' /etc/apache2/conf-available/kalx-secrets.conf
#   # Expected: 640 root:root ...
#
# Generating KALX_CRYPTO_PASSPHRASE / KALXSTAGE_CRYPTO_PASSPHRASE:
#   openssl rand -base64 32
#
# CLIENT_SECRET and CRYPTO_PASSPHRASE must each be identical between their
# respective auth.*.conf and staff.*.conf pairs so session cookies are
# mutually readable across both sites.

# ─── Production (staff.kalx.berkeley.edu / auth.kalx.berkeley.edu) ───────────

Define KALX_CLIENT_SECRET      YOUR_GOOGLE_CLIENT_SECRET
Define KALX_CRYPTO_PASSPHRASE  YOUR_OIDC_CRYPTO_PASSPHRASE

# ─── Staging (staff.stage.kalxstaff.org / auth.stage.kalxstaff.org) ──────────

Define KALXSTAGE_CLIENT_SECRET      YOUR_STAGE_GOOGLE_CLIENT_SECRET
Define KALXSTAGE_CRYPTO_PASSPHRASE  YOUR_STAGE_OIDC_CRYPTO_PASSPHRASE
